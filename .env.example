# ============================
# Local development (copy to .env)
# Remember to set the secrets and correct data path
#
# LLM_API_KEY is required together.ai
# ============================
# Data
# Path to the data root directory 
DATA_ROOT=/home/user/marcel-chatbot/data # or /data in docker
# Path to the data files
DATA_PATH=knowledgebase.jsonl
FAQ_PATH=faq.json
ADMINS_PATH=admins.json

# Authentication secret
# Use this to generate secret key: openssl rand -hex 32
SECRET_KEY=87a06... # 64 symbols (example value, replace with your own)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# LLM Use OpenAI-compatible API or local LLM server(e.g. ollama)
# At the time of this writing (06/25) Together AI has free models
MODEL_NAME=meta-llama/Llama-3.3-70B-Instruct-Turbo-Free
LLM_BASE_URL=https://api.together.xyz/v1/
LLM_API_KEY=tgp_v1_... # Set your Together AI API key here

# Hallucination detection with Kernel Language Entropy (KLE)
# For each answer, KLE_NUM_SAMPLES extra answers are generated and compared with an
# NLI model. If they disagree, the answer gets a warning. This multiplies LLM calls
# per question by (1 + KLE_NUM_SAMPLES); mind your provider's rate limits.
KLE_ENABLED=false
KLE_NUM_SAMPLES=5
KLE_TEMPERATURE=1.0
# Heat kernel time (paper default 0.3; 1.0 works better for long answers)
KLE_HEAT_T=1.0
# Flag answers whose normalised entropy (0-1) is at or above this value
KLE_THRESHOLD=0.4
# Changing the NLI model requires rebuilding the backend image
KLE_NLI_MODEL=cross-encoder/nli-deberta-v3-small
# Model used for the extra samples (defaults to MODEL_NAME)
KLE_SAMPLE_MODEL=
# Seconds to wait for the score after the answer finished streaming
KLE_TIMEOUT=45

# Local DB config (sqlite)
DATABASE_URI=sqlite:///database.db

# Production DB config (mariadb)
# MARIADB_DATABASE=marcel
# MARIADB_USER=marcel
# MARIADB_PASSWORD=... # Set a strong password
# MARIADB_ROOT_PASSWORD=... # Set a strong root password
# DATABASE_URI=mysql://${MARIADB_USER}:${MARIADB_PASSWORD}@database:3306/${MARIADB_DATABASE}